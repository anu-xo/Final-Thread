# ── Staging Environment Configuration ────────────────────────────────────
# Copy this to .env.staging and fill in your staging credentials.
# NEVER commit actual secrets. Set these via Render dashboard env vars.
# On Render, dashboard vars override anything in .env files.

PORT=5000
NODE_ENV=staging

# ── MongoDB Atlas (STAGING cluster) ────────────────────────────────────
# Create a separate staging cluster. NEVER reuse the production Atlas URI.
# This must point to a staging cluster, not production.
MONGODB_URI=mongodb+srv://<staging-user>:<staging-password>@<staging-cluster>.mongodb.net/threadverse_staging?retryWrites=true&w=majority

# ── Upstash Redis (STAGING instance) ────────────────────────────────────
# Create a separate staging Redis instance. NEVER reuse production Upstash.
REDIS_URL=rediss://default:<staging-token>@<staging-upstash>.upstash.io:6379

# ── JWT Secrets ─────────────────────────────────────────────────────────
JWT_SECRET=<generate-with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
JWT_REFRESH_SECRET=<generate-with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
JWT_UNSUB_SECRET=<generate-with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">

# ── AI APIs ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>
GROQ_API_KEY=<your-groq-api-key>

# ── Observability ───────────────────────────────────────────────────────
SENTRY_DSN=https://<key>@sentry.io/<project-id>

# ── Media Upload ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── Email ───────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.<your-sendgrid-api-key>

# ── URLs ────────────────────────────────────────────────────────────────
CLIENT_URL=https://threadverse.app
APP_URL=https://threadverse-server-staging.onrender.com

# ── Feature Flags ───────────────────────────────────────────────────────
API_DOCS_ENABLED=true
MONGOOSE_DEBUG=false
