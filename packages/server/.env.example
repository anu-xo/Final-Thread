PORT=5000

MONGODB_URI=mongodb://user:password@host:27017/threadverse?ssl=true&authSource=admin
REDIS_URL=rediss://default:password@host.upstash.io:6379

NODE_ENV=development
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_UNSUB_SECRET=your-jwt-unsub-secret

GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

SENTRY_DSN=https://your-key@sentry.io/your-project-id

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (SendGrid) — required for verification, password reset, and digest emails
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
CLIENT_URL=https://threadverse.app
APP_URL=https://api.threadverse.app

# NEO autonomous / passive triggers
NEO_STALE_POST_HOURS=12
NEO_STALE_MIN_COMMUNITY_MEMBERS=5
